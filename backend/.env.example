APP_NAME=AbsoluteCinema
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Duomenų bazė – PostgreSQL (kaip Render). Greitam paleidimui be PostgreSQL galima naudoti: DB_CONNECTION=sqlite
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=absolutecinema
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=array
CACHE_STORE=database
QUEUE_CONNECTION=sync

# JWT (php artisan jwt:secret sugeneruoja JWT_SECRET)
JWT_SECRET=
JWT_ACCESS_TTL=15
JWT_REFRESH_TTL=20160
# Lokaliai (http://localhost) false, produkcijoje (https) – true
JWT_COOKIE_SECURE=false
JWT_COOKIE_SAMESITE=strict

# Kiti domenai, kuriems leidžiama kreiptis į API iš naršyklės (atskirti kableliais)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Produkcijoje (https) – true
FORCE_HTTPS=false
